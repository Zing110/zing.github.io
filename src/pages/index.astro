---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="page-shell">
    <section class="profile" aria-labelledby="profile-name">
      <div class="portrait" aria-label="Zeqing Wang initials">ZW</div>

      <div class="profile-copy">
        <h1 id="profile-name">Zeqing Wang</h1>
        <p>
          I am a researcher and engineer interested in computer vision, 3D reconstruction,
          machine learning, and robotics.
        </p>
        <p>
          My work focuses on understanding motion and geometry from visual data, and on
          building clear, reproducible systems that connect research ideas with practical use.
        </p>
        <p class="profile-links">
          <a href="https://github.com/Zing110" target="_blank" rel="noopener noreferrer">GitHub</a>
          <span>/</span>
          <a href="https://github.com/Zing110?tab=repositories" target="_blank" rel="noopener noreferrer">Repositories</a>
          <span>/</span>
          <a href={`${import.meta.env.BASE_URL}about/`}>About</a>
        </p>
      </div>
    </section>

    <section class="content-section" aria-labelledby="news-title">
      <h2 id="news-title">News</h2>
      <ul class="news-list">
        <li><time datetime="2026-09">Sep 2026</time><span>This academic homepage is now live on GitHub Pages.</span></li>
      </ul>
    </section>

    <section class="content-section" aria-labelledby="research-title">
      <h2 id="research-title">Research Interests</h2>
      <div class="interest-list">
        <article>
          <h3>Computer Vision</h3>
          <p>Motion tracking, correspondence, and visual representations for dynamic scenes.</p>
        </article>
        <article>
          <h3>3D Reconstruction</h3>
          <p>Geometry-aware analysis and visualization for meshes, deformation, and spatial data.</p>
        </article>
        <article>
          <h3>Machine Learning & Robotics</h3>
          <p>Learning-based systems that connect perception, structured reasoning, and action.</p>
        </article>
      </div>
    </section>

    <section class="content-section" aria-labelledby="work-title">
      <h2 id="work-title">Selected Work</h2>
      <article class="publication">
        <div class="publication-figure" aria-hidden="true">
          <svg viewBox="0 0 260 150" role="img">
            <path d="M18 112 C53 49, 88 125, 126 59 S205 102, 241 32" />
            <path class="secondary" d="M17 83 C59 123, 99 26, 145 97 S211 45, 243 81" />
            <circle cx="18" cy="112" r="4" />
            <circle cx="89" cy="92" r="4" />
            <circle cx="126" cy="59" r="4" />
            <circle cx="190" cy="77" r="4" />
            <circle cx="241" cy="32" r="4" />
          </svg>
        </div>
        <div class="publication-copy">
          <h3><a href="https://github.com/Zing110/TADF" target="_blank" rel="noopener noreferrer">TADF</a></h3>
          <p class="publication-meta">Computer vision · 3D geometry · Research software</p>
          <p>A pipeline for generating motion tracks from video and visualizing displacement across 3D mesh sequences.</p>
          <p class="publication-links">
            <a href="https://github.com/Zing110/TADF" target="_blank" rel="noopener noreferrer">project page</a>
            <span>/</span>
            <a href="https://github.com/Zing110/TADF" target="_blank" rel="noopener noreferrer">code</a>
          </p>
        </div>
      </article>
    </section>

    <section class="content-section" aria-labelledby="software-title">
      <h2 id="software-title">Open Source</h2>
      <div class="simple-entry">
        <h3><a href="https://github.com/Zing110?tab=repositories" target="_blank" rel="noopener noreferrer">Code archive</a></h3>
        <p>Public experiments, course work, and software projects across Python, Rust, and the web.</p>
      </div>
    </section>
  </div>
</Layout>
