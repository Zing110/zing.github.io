---
const base = import.meta.env.BASE_URL; // '/zing.github.io/' (尾部有斜杠)

const navItems = [
  { href: '/#research', label: 'Research' },
  { href: '/#work', label: 'Selected work' },
  { href: '/about', label: 'About' },
];

// 拼接 base 前缀,首页特殊处理避免双斜杠
const url = (href: string) =>
  href === '/' ? base : `${base.replace(/\/$/, '')}${href}`;

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => href === '/about' && currentPath.endsWith('/about');
---

<header class="site-header">
  <nav class="container nav-shell" aria-label="Primary navigation">
    <a href={url('/')} class="wordmark" aria-label="Zeqing Wang — home">
      <span class="wordmark-mark">ZW</span>
      <span>Zeqing Wang</span>
    </a>

    <ul class="nav-links">
      {navItems.map((item) => (
        <li>
          <a
            href={url(item.href)}
            class:list={[
              'nav-link',
              isActive(item.href) && 'is-active'
            ]}
          >
            {item.label}
          </a>
        </li>
      ))}
      <li><a class="nav-link nav-external" href="https://github.com/Zing110" target="_blank" rel="noopener noreferrer">GitHub ↗</a></li>
    </ul>
  </nav>
</header>
