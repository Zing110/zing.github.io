---
const base = import.meta.env.BASE_URL; // '/zing.github.io/' (尾部有斜杠)

const navItems = [
  { href: '/', label: '首页' },
  { href: '/about', label: '关于' },
  { href: '/research', label: '研究' },
  { href: '/experience', label: '经历' },
  { href: '/chat', label: '对话' },
];

// 拼接 base 前缀,首页特殊处理避免双斜杠
const url = (href: string) =>
  href === '/' ? base : `${base.replace(/\/$/, '')}${href}`;

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) =>
  href === '/' ? currentPath === base.replace(/\/$/, '') : currentPath.endsWith(href);
---

<header class="fixed top-0 left-0 right-0 z-50 glass">
  <nav class="container flex items-center justify-between h-16">
    <a href={url('/')} class="text-lg font-semibold gradient-text">
      个人主页
    </a>

    <ul class="flex items-center gap-8">
      {navItems.map((item) => (
        <li>
          <a
            href={url(item.href)}
            class:list={[
              'text-sm transition-colors hover:text-white',
              isActive(item.href) ? 'text-white' : 'text-zinc-400'
            ]}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
